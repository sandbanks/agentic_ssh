# agentic_ssh.toml.example
#
# Reference configuration file blueprint for project-local configurations (.agentic_ssh.toml).
# To activate a local config, copy this to your project root as `.agentic_ssh.toml` and configure it.
#
# ---------------------------------------------------------------------------------
# 💡 AGENT-FRIENDLY DESCRIPTION CHEAT SHEET
#
# # ❌ BAD: description = "Checks the logs"
# # ✅ GOOD: description = "Fetches the last 100 lines of /var/log/app.log via tail. Returns plain text."
# ---------------------------------------------------------------------------------

# Global configuration flags (optional)
# disable_local_config = false
# allow_hosts = ["stan", "cartman", "kyle", "kenny", "*.local"]
# ignore_hosts = ["*.prod.company.com"]

# Host groups declaration
[groups]
nix = ["stan", "cartman", "kyle", "kenny"]
ubuntu = ["stan", "cartman", "kyle"]
oracle = ["kyle", "kenny"]
compose = ["stan", "kyle", "kenny"]
pi5 = ["stan", "cartman"]
uncloud = ["cartman"]

# Custom parameterized tools injected directly into the agent's workspace toolkit.
[tools.git_pull]
description = "Fetches and merges the latest git commits from an explicit remote branch target. Returns git command output."
command = ["git", "-C", "/home/richard/Projects/ldk", "pull", "origin", "{{branch}}"]
allow_hosts = ["stan"]
allow_shell = false

[tools.git_pull.params.branch]
validation = "strict" # Restricts inputs strictly to safe alphanumeric branch names and hyphens

[tools.check_service]
description = "Checks the execution state of system services. Runs systemctl status for a service. Returns a systemd status summary."
command = ["systemctl", "status", "{{service}}"]
allow_hosts = ["stan", "cartman", "*.local"]
allow_shell = false

[tools.check_service.params.service]
validation = "strict" # Requires a strict service name (e.g. nginx, docker) to protect against injection

[tools.server_reboot]
description = "DANGEROUS: Forcefully reboots target environment via reboot command. Returns reboot initiation status."
command = ["sudo", "reboot"]
allow_hosts = ["stan"]
allow_shell = false

# Debian / Ubuntu system package upgrade via detached systemd-run unit
# Resilient to network drops and Tailscale restarts during package upgrades.
[tools.safe_apt_upgrade]
description = "Executes a non-interactive system package upgrade in a detached systemd unit resilient to network/Tailscale drops. Returns instantly with unit name."
command = "sudo systemctl stop safe-apt-upgrade 2>/dev/null || true; sudo systemd-run --unit=safe-apt-upgrade --description='Safe System Package Upgrade' bash -c 'DEBIAN_FRONTEND=noninteractive apt-get update && DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -yq && apt-get autoremove -yq'"
allow_shell = true

[tools.check_upgrade_status]
description = "Checks the execution state of the background safe-apt-upgrade unit, recent journal logs, and whether a reboot is required."
command = "systemctl is-active safe-apt-upgrade 2>/dev/null && echo 'STATUS: RUNNING' || { echo 'STATUS: INACTIVE / COMPLETED'; journalctl -u safe-apt-upgrade -n 15 --no-pager 2>/dev/null; { [ -f /var/run/reboot-required ] || (command -v piboot-try >/dev/null 2>&1 && piboot-try --test >/dev/null 2>&1); } && echo '⚠️ REBOOT REQUIRED' || echo '✅ No reboot required'; }"
allow_shell = true
